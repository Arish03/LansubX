# Lansub X Environment Configuration

PROJECT_NAME="Lansub X"
ENVIRONMENT=development

# JWT Security
SECRET_KEY=lansubx_super_secret_jwt_key_development_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5441
POSTGRES_DB=lansubx
POSTGRES_USER=lansubx
POSTGRES_PASSWORD=lansubx_password_secure
DATABASE_URL=postgresql+asyncpg://lansubx:lansubx_password_secure@postgres:5432/lansubx

# Redis Message Bus
REDIS_HOST=redis
REDIS_PORT=6385
REDIS_URL=redis://redis:6379/0

# Mosquitto MQTT Broker
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=backend_secure_pass_123
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=gateway_secure_pass_123

# Web, API & CORS
BACKEND_PORT=6500
FRONTEND_PORT=6000
FRONTEND_URL=http://localhost:6000
CORS_ORIGINS=http://localhost:6000,http://127.0.0.1:6000
NEXT_PUBLIC_API_URL=http://localhost:6500
NEXT_PUBLIC_WS_URL=ws://localhost:6500

# Default Seeded Users
DEFAULT_SUPERADMIN_EMAIL=superadmin@lansubx.io
DEFAULT_SUPERADMIN_PASSWORD=SuperAdmin123!
DEFAULT_ADMIN_EMAIL=admin@lansubx.io
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
